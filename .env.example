# Meta Model API key (dev.meta.ai). Required for live runs; replay needs nothing.
META_API_KEY=
# Optional: open-weights route for the Analyst (meta | baseten | together | fireworks). Default: meta
ANALYST_PROVIDER=meta
BASETEN_API_KEY=
# Dashboard "Run live" sandbox: docker (default) or local (development only, no isolation)
APISHIFT_BACKEND=docker
